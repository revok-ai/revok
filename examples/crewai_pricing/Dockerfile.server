FROM python:3.12-slim

WORKDIR /app

# --- Install the revok package (mirrors Dockerfile.revok) -----------------
COPY pyproject.toml ./
COPY revok/ ./revok/

# --- Install demo + revok runtime dependencies ----------------------------
RUN pip install --no-cache-dir \
    "aiohttp>=3.9,<4" \
    "aiosqlite>=0.20,<1" \
    "networkx>=3.2,<4" \
    "pyyaml>=6.0,<7" \
    "fastapi>=0.110,<1" \
    "uvicorn[standard]>=0.27,<1" \
    "python-dotenv>=1.0,<2" \
    "pydantic>=2.5,<3" \
    "openai>=1.30,<2"

# --- Demo app sources -----------------------------------------------------
COPY examples/crewai_pricing/server.py ./
COPY examples/crewai_pricing/agent.py ./
COPY examples/crewai_pricing/database.py ./
COPY examples/crewai_pricing/demo_state.py ./

ENV PYTHONPATH=/app \
    DEMO_PORT=8080

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]
