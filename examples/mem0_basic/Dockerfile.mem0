FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "mem0ai>=0.1.27" \
    "fastapi>=0.110.0" \
    "uvicorn[standard]>=0.27.0" \
    "qdrant-client>=1.7.0" \
    "azure-identity>=1.15.0" \
    "openai>=1.0.0"

COPY mem0_server.py /app/mem0_server.py

EXPOSE 8000

CMD ["python", "mem0_server.py"]
