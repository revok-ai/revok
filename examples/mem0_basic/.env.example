# Copy this file to .env and fill in ONE of the two provider sections below.
# The server picks Azure OpenAI when AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT
# are both set; otherwise it falls back to plain OpenAI.

# -- Option A: Azure OpenAI / Azure AI Foundry -------------------------------
# Found in: Azure AI Foundry -> your project -> Settings -> API keys
# Paste the endpoint exactly as shown - any path/query suffix is stripped automatically.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com

# Deployment names - must match what you created in Azure AI Foundry
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDER_DEPLOYMENT=your-embedder-deployment-name

# API versions - LLM and embedder can differ (common with Foundry endpoints).
AZURE_OPENAI_LLM_API_VERSION=your-llm-api-version
AZURE_OPENAI_EMBEDDER_API_VERSION=your-embedder-api-version

# -- Option B: plain OpenAI ---------------------------------------------------
# Comment out Option A above and uncomment these lines instead.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_LLM_MODEL=gpt-5-mini
# OPENAI_EMBEDDER_MODEL=your-openai-embedder-model

# -- Optional: Revok graph backend config -------------------------------------
# Default uses NetworkX: revok.yaml
# Uncomment to run with FalkorDB Lite: revok.falkordb.yaml
# REVOK_CONFIG_FILE=revok.falkordb.yaml
