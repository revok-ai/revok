FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml ./
COPY revok/ ./revok/

RUN pip install --no-cache-dir \
    "aiohttp>=3.9,<4" \
    "aiosqlite>=0.20,<1" \
    "networkx>=3.2,<4" \
    "pyyaml>=6.0,<7" \
    "rapidfuzz>=3.0,<4"

ENV PYTHONPATH=/app

VOLUME ["/data"]
EXPOSE 7771

CMD ["python", "-m", "revok", "--config", "/app/revok.yaml"]
