# Copy to .env and fill in your values.
# Auto-detection at startup:
# - Azure OpenAI is used when BOTH AZURE_OPENAI_API_KEY and AZURE_OPENAI_ENDPOINT are set.
# - Otherwise plain OpenAI is used when OPENAI_API_KEY is set.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
DEMO_PORT=8081

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_PATH=pricing_demo.db
DB_PRODUCT_NAME=Orion Cache
DB_SEED_PRICE=500

# ---------------------------------------------------------------------------
# Revok proxy
# ---------------------------------------------------------------------------
REVOK_URL=http://localhost:7773
REVOK_ENTITY=orion_cache

# ---------------------------------------------------------------------------
# Mem0
# ---------------------------------------------------------------------------
MEM0_URL=http://localhost:7772

# ---------------------------------------------------------------------------
# Option A: Azure OpenAI (recommended)
# ---------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com
AZURE_OPENAI_LLM_DEPLOYMENT=your-llm-deployment-name
AZURE_OPENAI_EMBEDDER_DEPLOYMENT=your-embedder-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---------------------------------------------------------------------------
# Option B: plain OpenAI (uncomment to use)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBEDDER_MODEL=text-embedding-3-small
