FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml ./
COPY revok/ ./revok/

# Install all deps declared in pyproject.toml (includes rapidfuzz, aiohttp, etc.)
RUN pip install --no-cache-dir .

ENV PYTHONPATH=/app

VOLUME ["/data"]
EXPOSE 7771

CMD ["python", "-m", "revok", "--config", "/config/revok.yaml"]
