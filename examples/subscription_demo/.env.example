# Copy to .env and fill in your values.
# Auto-detection at startup:
# - Azure OpenAI is used when BOTH AZURE_OPENAI_API_KEY and AZURE_OPENAI_ENDPOINT are set.
# - Otherwise plain OpenAI is used when OPENAI_API_KEY is set.

# ---------------------------------------------------------------------------
# Azure Managed Redis (AMR) — required
# Must be a rediss:// TLS connection string.
# ---------------------------------------------------------------------------
AMR_URL=rediss://:<password>@<hostname>.redis.cache.windows.net:6380

# ---------------------------------------------------------------------------
# Redis Agent Memory Server (AMS)
# ---------------------------------------------------------------------------
AMS_PORT=8000
AMS_GENERATION_MODEL=azure/gpt-5-mini
AMS_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Revok
# ---------------------------------------------------------------------------
REVOK_PORT=7771
# Default image used by compose.yaml.
# Pin to a specific release tag if needed.
# REVOK_IMAGE=ghcr.io/revok-ai/revok:latest
# Default uses NetworkX config (revok.yaml).
# Uncomment to run with FalkorDB Lite (revok.falkordb.yaml).
# REVOK_CONFIG_FILE=revok.falkordb.yaml

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_PORT=8081
DEMO_PORT=8081

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
DASHBOARD_PORT=3001

# ---------------------------------------------------------------------------
# Database — all vars are optional (defaults shown)
# ---------------------------------------------------------------------------
DB_PATH=subscription_demo.db
# DB_CUSTOMER_ID=acme-corp
# DB_SEED_TIER=Enterprise
# DB_SEED_SEATS=50
# DB_SEED_FEATURES=Advanced Analytics, SSO, Priority API Access, Custom Integrations
# DB_SEED_API_RATE=1,000,000 requests/month
# DB_SEED_BILLING=Annual contract, locked rate through 2027-06-01

# ---------------------------------------------------------------------------
# Option A: Azure OpenAI (recommended for full Azure stack)
# ---------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com
# Keep this as host-only; app code appends /openai/v1.
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDER_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---------------------------------------------------------------------------
# Option B: plain OpenAI (uncomment to use instead of Azure OpenAI)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-5-mini
# OPENAI_EMBEDDER_MODEL=text-embedding-3-small
